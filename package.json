{
  "name": "tropiciel",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "description": "Osobisty tracker szukania pracy w IT: oferty z polskich portali i LinkedIna na tablicy kanban, ocena dopasowania do CV przez Claude'a (MCP).",
  "scripts": {
    "dev": "next dev -H 127.0.0.1 -p 3100",
    "build": "next build",
    "start": "next start -H 127.0.0.1 -p 3100",
    "mcp": "bun mcp/server.ts",
    "scan": "bun scripts/scan.ts",
    "refilter": "bun scripts/refilter.ts",
    "demo": "bun scripts/demo.ts",
    "demo:clear": "bun scripts/demo.ts --clear",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "check": "bun run typecheck && bun run lint && bun run test && bun run build"
  },
  "engines": {
    "node": ">=20.9"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "docx": "^9.15.3",
    "mammoth": "^1.13.0",
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "unpdf": "^2.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10",
    "eslint-config-next": "16.4.5",
    "fflate": "^0.8.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^5.0.5"
  }
}
